# Copy to config.env and adjust values for the deployment host.
GLM_OCR_V2_CONDA_BASE=/data/wilson_2/soft/miniforge3
GLM_OCR_V2_CONDA_ENV=med_rag_cuda
GLM_OCR_V2_SERVICE_CONFIG=/data/wilson_2/de/glm_ocr/code/glm_ocr/config/ocr_services_v2.yaml
# 服务、队列、模型接口和设备配置统一维护在 ocr_services_v2.yaml。
PPU_SDK=/usr/local/PPU_SDK
PPU_HOME=/usr/local/PPU_SDK
CUDA_PATH=/usr/local/PPU_SDK/CUDA_SDK
PPU_RTC_CACHE_DIR=/data/wilson_2/cache/rtccache
# Override only if the PPU runtime uses a different user's home directory.
PPU_RTC_CACHE_LINK=/home/whs/.rtccache
