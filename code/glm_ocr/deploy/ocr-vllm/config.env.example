# Copy to deploy/ocr-vllm/config.env and set the vLLM executable for the host.
# For the original PPU environment this was /opt/ac2/bin/vllm.
VLLM_BIN=/path/to/ppu-env/bin/vllm

GLM_OCR_MODEL_PATH=/data/wilson_2/de/models/ZhipuAI/GLM-OCR
PADDLE_OCR_MODEL_PATH=/data/wilson_2/de/models/PaddlePaddle/PaddleOCR-VL-1___6
GLM_OCR_VLLM_DEVICE=2
GLM_OCR_VLLM_PORT=18080
PADDLE_OCR_VLLM_DEVICE=1
PADDLE_OCR_VLLM_PORT=18081
OCR_VLLM_GPU_MEMORY_UTILIZATION=0.3
OCR_VLLM_MAX_MODEL_LEN=8192
