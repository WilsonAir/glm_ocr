# Copy to config.env and adjust values for the deployment host.
PADDLE_OCR_CONDA_BASE=/data/wilson_2/conda
PADDLE_OCR_CONDA_ENV=paddle_ocr
PADDLE_OCR_SERVICE_CONFIG=/data/wilson_2/de/glm_ocr/code/paddle_ocr/config/ocr_services.yaml
PADDLE_OCR_HOST=127.0.0.1
PADDLE_OCR_PORT=18093
PADDLE_OCR_OUTPUT_ROOT=/data/wilson_2/de/glm_ocr/result/paddle_ocr/framework
PPU_SDK=/usr/local/PPU_SDK
CUDNN_HOME=/usr/local/PPU_SDK/CUDA_SDK
PADDLEX_HOME=/data/wilson_2/.paddlex
# Do not load ~/.local/lib/python*/site-packages.
PYTHONNOUSERSITE=1
# Writable overlay for packages that cannot be installed into root-owned conda env.
PADDLE_OCR_DEPS_DIR=/data/wilson_2/de/glm_ocr/code/paddle_ocr/.deps
