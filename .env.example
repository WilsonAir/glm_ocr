# 阿里云 OSS。复制为仓库根目录的 .env 后填写真实值；.env 已被 Git 忽略。
# 供 glm-ocr-task-queue、glm-ocr-v2、paddle-ocr（/parse_oss）共用，勿写入 deploy/*/config.env。
# paddle-ocr 启动时会将结果前缀设为 paddle_ocr_output（可用 PADDLE_OCR_OSS_PREFIX 覆盖）。
OSS_ENDPOINT=https://oss-cn-<region>.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_PREFIX=glm_ocr_output

# 可选：签名下载链接有效期（秒）。
OSS_SIGNED_URL_EXPIRES_SECONDS=3600
